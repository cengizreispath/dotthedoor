# Copy to .env.local for development. In Coolify, set these as environment variables.

# Postgres (Coolify: create a PostgreSQL resource and paste its internal URL here)
DATABASE_URL=postgres://dotthedoor:dotthedoor@localhost:5433/dotthedoor

# Random string; used to scramble visitor IPs for rate limiting (never stored raw)
IP_SALT=change-me

# /admin moderation panel
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-too

# Optional: Claude moderation classifier. Without it, only the built-in rules run.
ANTHROPIC_API_KEY=

# Optional: Cloudflare Turnstile (bot check on publishing). Both or neither.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
